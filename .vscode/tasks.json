{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Git Commit & Push",
            "type": "shell",
            "command": "git add .; git commit -m \"${input:commitMessage}\"; if ($LASTEXITCODE -eq 0) { git push; git status }",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "commitMessage",
            "type": "promptString",
            "description": "Commit message"
        }
    ]
}
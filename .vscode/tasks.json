{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Git Commit & Push",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "git add . && git commit -m \"${input:commitMessage}\" && git push && git status"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "commitMessage",
            "type": "promptString",
            "description": "Enter commit message"
        }
    ]
}